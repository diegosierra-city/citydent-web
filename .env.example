# ============================================================
# CityDent Web — variables de entorno
# Copia este archivo como .env para desarrollo local
# y como .env.production para el build de despliegue.
#
# Sólo las variables con prefijo PUBLIC_* se exponen al cliente.
# ============================================================

# Widget del chatbot CityDent (cc-widget.js)
# En desarrollo suele ser http://localhost:3000/cc-widget.js
# En producción: https://api.citydent.app/cc-widget.js (ver .env.production)
PUBLIC_CHAT_WIDGET_URL=http://localhost:3000/cc-widget.js

# public-id que entrega la plataforma del chatbot.
# Debe ser un agente con el módulo de Citas en modo «agenda conectada»
# y su comprobación en estado OK; si no, la demo de la landing no reserva.
PUBLIC_CHAT_WIDGET_ID=

# Formulario de contacto (POST /web/contacto de la API).
# En desarrollo: http://localhost:8000/web/contacto
# En producción: https://api.citydent.app/web/contacto
PUBLIC_CONTACT_ENDPOINT=http://localhost:8000/web/contacto
