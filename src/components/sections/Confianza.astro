---
/**
 * Escenas 8 y 9 (§3.8–3.9): transparencia como argumento de venta y
 * Programa Clínicas Fundadoras.
 *
 * Fronteras de honestidad: aquí no se publica ningún porcentaje, sello de
 * cumplimiento ni afirmación sobre servidores o entrenamiento de modelos.
 */
const limits = [
  {
    title: 'Responde con tu información, no con inventos',
    body: 'El asistente se configura con los contenidos y las indicaciones que nos facilitas, y los revisamos contigo antes de la puesta en marcha.',
  },
  {
    title: 'No diagnostica, no trata, no improvisa',
    body: 'No sustituye una consulta, no valora síntomas ni recomienda tratamientos personalizados. Cuando una consulta necesita atención profesional, indica cómo contactar con la clínica.',
  },
  {
    title: 'Nada se activa sin tu acuerdo',
    body: 'Acordamos qué canales y funciones se ponen en marcha, cómo se prueban y qué incluye el servicio. Lo que no está configurado, no se promete.',
  },
  {
    title: 'Tu información, tratada como lo que es',
    body: 'Antes de activar el servicio revisamos qué datos necesita utilizar y las condiciones de tratamiento aplicables a tu clínica. Para reservar pide lo mínimo: nombre, correo y la hora elegida. No pide historiales, radiografías ni datos de salud, y no los almacena.',
  },
];

const never = [
  'Diagnosticar ni recomendar tratamientos.',
  'Inventar precios, horarios o disponibilidad.',
  'Presentarse como una persona.',
  'Prometer por ti lo que no configuraste.',
  'Escribir en tu agenda por su cuenta: la reserva la confirma el paciente con un botón.',
  'Inventar una hora libre: si la agenda no responde, lo dice.',
  'Cambiar o cancelar una cita: eso sigue haciéndolo tu equipo.',
];

const founderPerks = [
  {
    title: 'Plaza prioritaria',
    body: 'En la próxima incorporación disponible.',
  },
  {
    title: 'Canal directo',
    body: 'Para proponer mejoras que iremos incorporando al producto.',
  },
  {
    title: 'Condiciones de fundador',
    body: 'Durante el primer periodo del servicio.',
  },
  {
    title: 'Tu clínica, primer caso de éxito',
    body: 'Si quedas satisfecho, podrás ser una de las primeras clínicas que presentemos públicamente.',
  },
];
---

<section id="confianza" class="band bg-ink text-white">
  <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <div class="lg:sticky lg:top-28">
        <h2 class="heading-section text-white" data-reveal="mask">
          Podríamos prometerte milagros.{' '}
          <span class="text-brand-teal">Preferimos enseñarte los límites.</span>
        </h2>
        <p class="prose-measure mt-6 text-white/85" data-reveal="up">
          Un asistente fiable no es el que lo promete todo: es el que sabe
          exactamente hasta dónde llega. Estos son nuestros límites, y son los
          que hacen que puedas confiar en CityDent.
        </p>

        <div class="mt-10 rounded-[1.3rem] border border-white/15 bg-white/[0.04] p-6" data-reveal="up">
          <p class="kicker text-brand-teal">Lo que CityDent nunca hará</p>
          <ul class="mt-4 flex flex-col gap-3">
            {never.map((item) => (
              <li class="flex items-start gap-3 text-base leading-relaxed text-white/90">
                <svg class="mt-1 h-4 w-4 flex-none text-brand-teal" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" d="M6 6l12 12M18 6 6 18" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="mt-10" data-reveal="up">
          <a
            href="#contacto"
            class="inline-flex rounded-full border border-white/45 px-7 py-3.5 font-semibold text-white transition-colors hover:border-brand-teal hover:text-brand-teal"
          >
            Consultar alcance y privacidad
          </a>
        </div>
      </div>
    </div>

    <dl class="lg:col-span-7" data-reveal="list">
      {limits.map((limit) => (
        <div data-reveal-item class="border-t border-white/15 py-8 first:border-t-0 first:pt-0">
          <dt class="heading-sub text-white">{limit.title}</dt>
          <dd class="mt-3 max-w-[62ch] text-base leading-relaxed text-white/80 md:text-lg">
            {limit.body}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<section id="fundadoras" class="band bg-paper text-ink">
  <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-6">
      <p class="kicker text-brand-deep" data-reveal="up">Programa Clínicas Fundadoras</p>
      <h2 class="heading-section mt-4 text-ink" data-reveal="mask">
        CityDent llega a España clínica a clínica. Las primeras tienen nombre y
        apellido.
      </h2>
      <p class="prose-measure mt-6 text-mist" data-reveal="up">
        Cada puesta en marcha es acompañada: revisamos contenidos, probamos
        respuestas y activamos contigo. Por eso incorporamos un número limitado
        de clínicas al mes. Las primeras forman parte del Programa Clínicas
        Fundadoras.
      </p>

      <div class="mt-9" data-reveal="up">
        <a
          href="#contacto"
          class="gradient-cta inline-flex rounded-full px-7 py-3.5 font-semibold text-white shadow-lg shadow-brand-blue/25 transition-transform hover:scale-[1.03]"
        >
          Reservar plaza fundadora
        </a>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-mist">
          Reservar plaza no implica ningún pago: confirmamos disponibilidad y
          condiciones en tu propuesta.
        </p>
      </div>
    </div>

    <ul class="lg:col-span-6 lg:pt-14" data-reveal="list">
      {founderPerks.map((perk) => (
        <li data-reveal-item class="border-t border-ink/12 py-6 first:border-t-0 first:pt-0">
          <div class="flex items-start gap-4">
            <span class="mt-1.5 h-2 w-2 flex-none rounded-full gradient-bubble" aria-hidden="true"></span>
            <div>
              <h3 class="font-display text-xl font-semibold text-ink">{perk.title}</h3>
              <p class="mt-2 text-base leading-relaxed text-mist">{perk.body}</p>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
