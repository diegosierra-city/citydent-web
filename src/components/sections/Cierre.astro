---
/**
 * Escena 13 (§3.13): cierre con recapitulación y solicitud de propuesta.
 * La recapitulación precede al pedido de datos para que el último paso
 * cueste menos que el primero.
 */
import ContactForm from '../ContactForm.svelte';

const recap = [
  'Web y WhatsApp incluidos para las consultas habituales.',
  'Agenda opcional: reservas con confirmación del paciente.',
  'Apoyo para recepción, más espacio para el trato personal.',
];
---

<section id="contacto" class="band bg-ink text-white">
  <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <h2 class="heading-section text-white" data-reveal="mask">
        Solicita una propuesta{' '}
        <span class="text-brand-teal">para tu clínica.</span>
      </h2>

      <ul class="mt-8 flex flex-col gap-4" data-reveal="list">
        {recap.map((line) => (
          <li data-reveal-item class="flex items-start gap-3 text-lg leading-relaxed text-white/90">
            <span class="mt-2.5 h-1.5 w-1.5 flex-none rounded-full gradient-bubble" aria-hidden="true"></span>
            {line}
          </li>
        ))}
      </ul>

      <p class="mt-8 max-w-md text-base leading-relaxed text-white/80" data-reveal="up">
        Cuéntanos cómo trabaja tu clínica. Te proponemos el alcance, la
        configuración y el coste, con agenda opcional si la necesitas.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3" data-reveal="up">
        <a
          href="#demo"
          class="inline-flex items-center gap-2 font-semibold text-brand-teal underline decoration-brand-teal/40 underline-offset-4 transition-colors hover:text-white"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 6 5 12l6 6M5 12h14" />
          </svg>
          Volver a la demo
        </a>
        <a
          href="https://app.citydent.app/login"
          class="inline-flex items-center gap-2 rounded-full border border-white/30 px-5 py-2.5 font-semibold text-white transition-colors hover:border-brand-teal hover:text-brand-teal"
        >
          Acceso a la aplicación
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M7 7h10v10" />
          </svg>
        </a>
      </div>
    </div>

    <div class="lg:col-span-7" data-reveal="rise">
      <ContactForm client:load />
    </div>
  </div>
</section>
