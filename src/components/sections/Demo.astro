---
/**
 * Escena 6 (§3.6): la demo es el argumento de venta número uno.
 *
 * El asistente real es el widget global (ChatDock). Esta sección lo invita,
 * lo enmarca y lo abre: los botones pulsan el launcher que crea cc-widget.js.
 * Si el widget no está disponible, se muestra el aviso previsto en la propuesta
 * y la salida hacia #contacto; nunca un control muerto.
 */
const suggestions = [
  '¿Cuál es vuestro horario?',
  '¿Dónde está la clínica?',
  'Quiero pedir una primera cita.',
  '¿Qué hueco tenéis este sábado?',
];
---

<section id="demo" class="band demo-section bg-paper text-ink" data-demo>
  <div class="shell grid gap-14 lg:grid-cols-12 lg:items-start lg:gap-16">
    <div class="lg:col-span-6">
      <h2 class="heading-section text-ink" data-reveal="mask">
        Pruébalo como lo haría un paciente.
      </h2>
      <p class="prose-measure mt-6 text-mist" data-reveal="up">
        Esta es una clínica ficticia con su información de ejemplo. Escribe lo
        que escribiría un paciente y comprueba cómo responde CityDent.
      </p>

      <div class="mt-9" data-reveal="up">
        <button
          type="button"
          class="gradient-cta inline-flex items-center gap-2.5 rounded-full px-7 py-3.5 font-semibold text-white shadow-lg shadow-brand-blue/25 transition-transform hover:scale-[1.03]"
          data-demo-open
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.9 8.9 0 0 1-3.8-.8L3 21l1.9-4.9A8.4 8.4 0 0 1 12 3.1a8.4 8.4 0 0 1 9 8.4Z" />
          </svg>
          Abrir la demostración
        </button>
        <p class="mt-3 text-sm text-mist" data-demo-hint>
          Se abre el asistente en esta misma página. Sin registro.
        </p>
        <p class="demo-fallback mt-4 hidden rounded-[1rem] bg-ink/[0.05] p-4 text-sm leading-relaxed text-ink" role="status" data-demo-fallback>
          No podemos iniciar la demo en este momento. Puedes volver a intentarlo
          o <a class="font-semibold text-brand-deep underline decoration-brand-deep/40 underline-offset-2" href="#contacto">solicitar una demostración con nuestro equipo</a>.
        </p>
      </div>

      <div class="mt-10 rounded-[1.2rem] border border-ink/12 bg-ink/[0.03] p-5" data-reveal="up">
        <p class="text-sm leading-relaxed text-ink">
          Estás hablando con una IA sobre una clínica ficticia, con una agenda de
          ejemplo. Puedes reservar de verdad: la cita se escribe en esa agenda de
          prueba, no en la de ninguna clínica. No introduzcas datos personales ni
          información de salud reales. La demo no ofrece asesoramiento clínico.
        </p>
      </div>
    </div>

    <div class="lg:col-span-6 lg:pl-6">
      <div class="rounded-[1.6rem] border border-ink/10 bg-white p-5 shadow-[0_28px_70px_-40px_rgba(12,38,65,0.55)] md:p-6" data-reveal="rise">
        <div class="flex items-center justify-between gap-4 border-b border-ink/10 pb-4">
          <p class="text-sm font-semibold text-ink">CityDent · Clínica de demostración</p>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-teal/12 px-2.5 py-1 text-xs font-semibold text-brand-deep">
            <span class="h-1.5 w-1.5 rounded-full bg-brand-teal" aria-hidden="true"></span>
            Demo con IA
          </span>
        </div>

        <div class="mt-5 flex flex-col gap-3">
          <p class="bubble bubble-assistant max-w-[92%] self-start gradient-bubble text-ink">
            Hola, soy el asistente de IA de esta clínica de demostración. Puedo
            ayudarte con información general, consultar horas disponibles y
            preparar una reserva de prueba. ¿Qué te gustaría probar?
          </p>
        </div>

        <p class="mt-6 text-xs font-semibold tracking-wide text-mist uppercase">
          Empieza por aquí
        </p>
        <ul class="mt-3 flex flex-col gap-2">
          {suggestions.map((suggestion) => (
            <li>
              <button
                type="button"
                class="suggestion w-full rounded-[1rem] border border-ink/12 bg-white px-4 py-3 text-left text-[0.95rem] text-ink"
                data-demo-open
              >
                {suggestion}
              </button>
            </li>
          ))}
        </ul>
        <p class="mt-3 text-xs leading-relaxed text-mist">
          Al pulsar se abre el asistente: escribe la pregunta tal cual y mira
          qué responde.
        </p>
      </div>
    </div>
  </div>

  <!-- Cierre tras la prueba: el pico de intención apunta a la propuesta -->
  <div class="shell mt-16 border-t border-ink/12 pt-10 lg:mt-20">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
      <p class="prose-measure text-ink lg:col-span-7" data-reveal="up">
        Así puedes explorar el asistente antes de decidir. Para tu clínica,
        revisamos los contenidos, conectamos los canales y probamos el calendario
        de citas si eliges incluirlo.
      </p>
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center lg:col-span-5 lg:justify-end" data-reveal="up">
        <a
          href="#contacto"
          class="gradient-cta rounded-full px-7 py-3.5 text-center font-semibold text-white shadow-lg shadow-brand-blue/25 transition-transform hover:scale-[1.03]"
        >
          Solicitar propuesta
        </a>
        <a
          href="#precios"
          class="rounded-full border border-ink/25 px-7 py-3.5 text-center font-semibold text-ink transition-colors hover:border-brand-deep hover:text-brand-deep"
        >
          Ver precios y condiciones
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .suggestion {
    transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
  }

  .suggestion:hover {
    border-color: var(--color-brand-blue);
    transform: translateY(-1px);
    box-shadow: 0 10px 24px -16px rgb(12 38 65 / 0.5);
  }

  .suggestion:active {
    transform: translateY(0);
  }
</style>

<script>
  /**
   * cc-widget.js crea su propio botón (`.cc-widget-launcher`) y pinta el chat
   * en un iframe, así que aquí sólo se delega la apertura y se informa cuando
   * el widget no llegó a cargar.
   */
  const section = document.querySelector<HTMLElement>('[data-demo]');
  const launcher = () => document.querySelector<HTMLButtonElement>('.cc-widget-launcher:not([hidden])');

  const showFallback = (visible: boolean) => {
    section?.querySelector('[data-demo-fallback]')?.classList.toggle('hidden', !visible);
  };

  const openDemo = () => {
    const button = launcher();
    if (!button) {
      showFallback(true);
      return;
    }
    showFallback(false);
    if (button.getAttribute('aria-expanded') !== 'true') button.click();
  };

  section?.querySelectorAll('[data-demo-open]').forEach((control) => {
    control.addEventListener('click', openDemo);
  });

  /* El widget se carga en ocioso: se comprueba dos veces antes de avisar. */
  const check = () => showFallback(!launcher());
  window.setTimeout(check, 4000);
  window.setTimeout(check, 9000);
</script>
